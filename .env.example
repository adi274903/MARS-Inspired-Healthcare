# ─────────────────────────────────────────────────────────────────────────────
# EvalBot backend configuration. Copy to `.env` and fill in the starred values.
# Everything has a working default except the OpenRouter key.
# The services read this file via your shell, e.g.:
#   set -a; . ./.env; set +a; MONOLITH=1 .venv/bin/python -m services.monolith.app
# ─────────────────────────────────────────────────────────────────────────────

# ★ REQUIRED for real answers (LLM_PROVIDER=openrouter). Get it at
#   https://openrouter.ai/keys — without it the stack still runs on LLM_PROVIDER=mock.
OPENROUTER_API_KEY=

# ── model selection (hot-swappable; per-intent profiles live in models.yaml) ──
# mock          = offline extractive answers, no network, used by tests and demos
# openrouter    = OpenRouter (default, serves the Gemma 4 26B-A4B MoE endpoint)
# openai_compat = any OpenAI-compatible server (vLLM, Ollama, LM Studio, Together)
# hf_local      = in-process transformers (needs requirements-optional.txt)
# NOTE: LLM_PROVIDER overrides the provider from models.yaml for every profile.
LLM_PROVIDER=mock
# Default model slug; verified against OpenRouter's /models at startup, with
# fallbacks from models.yaml if it does not resolve.
GEMMA_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Used only when LLM_PROVIDER=openai_compat:
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_API_KEY=sk-local
MODELS_YAML=models.yaml
# Curated guidance corpus (reporting guidelines, governance frameworks, norm papers).
# Cited as type:"web" and never counted in corpus statistics.
GUIDANCE_PATH=guidance/sources.yaml

TEMPERATURE=0.2
MAX_TOKENS=1200
LLM_TIMEOUT=120
GUIDED_JSON=1
# Streaming batch: publish an llm.token event per N chars or every N ms.
TOKEN_BATCH_CHARS=24
TOKEN_BATCH_MS=40

# ── topology ─────────────────────────────────────────────────────────────────
# MONOLITH=1 runs every service in one process over the in-memory bus.
# Leave 0 when running the services as separate processes (podman pod / Redis).
MONOLITH=1
# memory = in-process bus (monolith, tests) · redis = Redis Streams (split topology)
BUS=memory
REDIS_URL=redis://localhost:6379/0
EVENTS_STREAM=evalbot.events
LOG_LEVEL=info

# Ports. 8000 is assumed taken by the static frontend (`python3 -m http.server 8000`).
PORT=8080
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CHAT_TIMEOUT_S=120
# Bearer token for /api/admin/* on the control plane.
ADMIN_TOKEN=dev-token

# ── data (build outputs; no dataset is read at request time) ──────────────────
DB_PATH=data/papers.db
JSONL_PATH=data/papers.jsonl
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=evalbot_papers
EVENTS_DB=events/events.db
MODELS_DB=data/models.db

# Build input only. Used by `python -m ingest.ingest` when --xlsx is not passed.
DATASET_PATH=final_merged_dataset.xlsx

# ── retrieval ────────────────────────────────────────────────────────────────
NUM_EVIDENCE=8
MAX_ABSTRACT_CHARS=900
RRF_K=60
# Disable a leg to degrade gracefully; the answer still returns.
SQLITE_ENABLED=1
VECTOR_ENABLED=1
GRAPH_ENABLED=1
# hash = dependency-free deterministic embeddings (offline, tests, demo)
# local = sentence-transformers (needs requirements-optional.txt)
# none = vector leg disabled
# Dense leg. local = google/embeddinggemma-2 (768-d, asymmetric task/query/document
# prompts). hash = dependency-free lexical fallback used by the offline tests.
# EMBED_DIM may be a Matryoshka truncation (<= 768); the Qdrant collection must be
# rebuilt with `python -m ingest.qdrant_index --recreate` when the dim changes.
EMBED_PROVIDER=local
EMBED_MODEL=google/embeddinggemma-2
EMBED_DIM=768
EMBED_DEVICE=cpu
EMBED_BATCH=32

# Optional graph backend. Empty = the graph leg is evaluated over SQLite
# (LocalGraph), so Neo4j is never required for the system to answer.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
